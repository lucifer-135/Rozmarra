<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<style>
  /* The plan prints on A4 paper with large text (docs/techstack.md, Section 11.5). */
  @page { size: A4; margin: 15mm; }
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 24px;
    background: #ffffff;
    color: #111111;
    font-family: 'Noto Sans', 'Noto Sans Devanagari', 'Nirmala UI', 'Mangal', Arial, sans-serif;
    font-size: 18px;
    line-height: 1.55;
  }
  main { max-width: 760px; margin: 0 auto; }
  h1 { font-size: 26px; margin: 0 0 4px; line-height: 1.3; }
  h2 { font-size: 20px; margin: 22px 0 6px; border-bottom: 1px solid #c3c2b7; padding-bottom: 4px; }
  p { margin: 6px 0; }
  ul { margin: 6px 0; padding-left: 24px; }
  li { margin: 4px 0; }
  .patient { font-size: 20px; font-weight: 600; margin: 0 0 12px; }
  .rule {
    border: 3px solid #b42318;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 14px 0;
    font-size: 20px;
    font-weight: 700;
    background: #fff5f4;
  }
  .rule-title { display: block; font-size: 16px; text-transform: uppercase; letter-spacing: 0.04em; color: #b42318; }
  .approval { margin-top: 22px; padding: 10px 14px; border: 1px solid #0b6b3a; border-radius: 8px; font-weight: 600; }
  .note { color: #52514e; font-size: 16px; margin-top: 18px; }
  .time { font-weight: 600; white-space: nowrap; }
  @media print {
    body { padding: 0; font-size: 14pt; }
    h1 { font-size: 20pt; }
    h2 { font-size: 16pt; break-after: avoid; }
    .patient, .rule { font-size: 15pt; }
    .rule-title, .note { font-size: 14pt; }
    .rule, .approval { break-inside: avoid; }
  }
</style>
</head>
<body>
<main>
{% block content %}{% endblock %}
</main>
</body>
</html>
